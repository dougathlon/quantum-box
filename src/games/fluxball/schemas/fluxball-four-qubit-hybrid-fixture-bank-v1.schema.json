{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fluxball:schema:four-qubit-hybrid-fixture-bank:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureBankId",
    "defaultFixtureId",
    "compiledAt",
    "deliveryMode",
    "acquisitionSource",
    "derivationMethod",
    "model",
    "provenance",
    "costEstimate",
    "fixtures",
    "calibration"
  ],
  "properties": {
    "schemaVersion": {
      "const": "fluxball-four-qubit-hybrid-fixture-bank-v1"
    },
    "fixtureBankId": { "const": "fluxball-aer-four-qubit-hybrid-v1" },
    "defaultFixtureId": {
      "const": "fluxball-four-player-hybrid-preparation-v1"
    },
    "compiledAt": { "type": "string", "format": "date-time" },
    "deliveryMode": { "const": "committed-fixture" },
    "acquisitionSource": { "const": "finite-shot-aer" },
    "derivationMethod": {
      "const": "joint-counts-plus-pairwise-lstsq-psd"
    },
    "model": { "$ref": "#/$defs/model" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "costEstimate": { "$ref": "#/$defs/cost" },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fluxball-four-player-hybrid-preparation-v1"],
      "properties": {
        "fluxball-four-player-hybrid-preparation-v1": {
          "$ref": "#/$defs/fixture"
        }
      }
    },
    "calibration": { "$ref": "#/$defs/calibration" }
  },
  "$defs": {
    "contextNumbers": {
      "$ref": "urn:fluxball:schema:four-qubit-fixture-bank:v1#/$defs/contextNumbers"
    },
    "fourContexts": {
      "$ref": "urn:fluxball:schema:four-qubit-fixture-bank:v1#/$defs/contexts"
    },
    "fullCountContexts": {
      "$ref": "urn:fluxball:schema:four-qubit-fixture-bank:v1#/$defs/countContexts"
    },
    "pairContexts": {
      "$ref": "urn:fluxball:schema:fixture-bank:v1#/$defs/contextDistributions"
    },
    "sha": {
      "$ref": "urn:fluxball:schema:four-qubit-fixture-bank:v1#/$defs/sha"
    },
    "circuit": {
      "$ref": "urn:fluxball:schema:four-qubit-fixture-bank:v1#/$defs/circuit"
    },
    "verifiedSource": {
      "$ref": "urn:fluxball:schema:four-qubit-fixture-bank:v1#/$defs/verifiedSource"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId",
        "numQubits",
        "playerOrder",
        "qubitMap",
        "configuredEdges",
        "characterizedEdges",
        "topologyKind",
        "initialCircuit"
      ],
      "properties": {
        "modelId": { "const": "fluxball-four-qubit-rulefield-hybrid-v1" },
        "numQubits": { "const": 4 },
        "playerOrder": { "const": ["A", "B", "C", "D"] },
        "qubitMap": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["qubit", "playerId", "displayName"],
            "properties": {
              "qubit": { "type": "integer", "minimum": 0, "maximum": 3 },
              "playerId": { "enum": ["A", "B", "C", "D"] },
              "displayName": { "type": "string", "minLength": 1 }
            }
          }
        },
        "configuredEdges": {
          "const": [
            [0, 2],
            [2, 1],
            [1, 3],
            [3, 0]
          ]
        },
        "characterizedEdges": {
          "const": [
            [0, 2],
            [0, 3],
            [1, 2],
            [1, 3]
          ]
        },
        "topologyKind": { "const": "four-player-court-ring" },
        "initialCircuit": { "$ref": "#/$defs/circuit" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "platform",
        "packageVersions",
        "quantumGraphCommit",
        "pairwiseTomographyCommit",
        "verifiedSources",
        "sourceRelationship",
        "lineage",
        "qpu",
        "remoteService",
        "mothApi"
      ],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "packageVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantumgraph",
            "pairwise-tomography",
            "qiskit",
            "qiskit-aer",
            "numpy",
            "scipy"
          ],
          "properties": {
            "quantumgraph": { "const": "0.0.1" },
            "pairwise-tomography": { "const": "0.1.0" },
            "qiskit": { "const": "2.2.3" },
            "qiskit-aer": { "const": "0.17.2" },
            "numpy": { "const": "2.0.2" },
            "scipy": { "const": "1.13.1" }
          }
        },
        "quantumGraphCommit": {
          "const": "6917364b9496bd324225e87e6dd986bce52ecefd"
        },
        "pairwiseTomographyCommit": {
          "const": "dbab12513281bd8ca7828252cf2e98a1a5749761"
        },
        "verifiedSources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quantumgraph", "pairwise-tomography"],
          "properties": {
            "quantumgraph": { "$ref": "#/$defs/verifiedSource" },
            "pairwise-tomography": { "$ref": "#/$defs/verifiedSource" }
          }
        },
        "sourceRelationship": { "type": "string", "minLength": 1 },
        "lineage": { "type": "string", "minLength": 1 },
        "qpu": { "const": false },
        "remoteService": { "const": false },
        "mothApi": { "const": false }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureCount",
        "characterizationCircuitsPerFixture",
        "totalCircuitExecutions",
        "shotsPerCircuit",
        "totalShots"
      ],
      "properties": {
        "fixtureCount": { "const": 1 },
        "characterizationCircuitsPerFixture": { "const": 9 },
        "totalCircuitExecutions": { "const": 9 },
        "shotsPerCircuit": { "type": "integer", "minimum": 128 },
        "totalShots": { "type": "integer", "minimum": 1152 }
      }
    },
    "tomographyCountVector": {
      "type": "object",
      "minProperties": 16,
      "maxProperties": 16,
      "propertyNames": { "pattern": "^[+-]{4}$" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "tomographyCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "XXXX",
        "XXYY",
        "XXZZ",
        "YYXX",
        "YYYY",
        "YYZZ",
        "ZZXX",
        "ZZYY",
        "ZZZZ"
      ],
      "properties": {
        "XXXX": { "$ref": "#/$defs/tomographyCountVector" },
        "XXYY": { "$ref": "#/$defs/tomographyCountVector" },
        "XXZZ": { "$ref": "#/$defs/tomographyCountVector" },
        "YYXX": { "$ref": "#/$defs/tomographyCountVector" },
        "YYYY": { "$ref": "#/$defs/tomographyCountVector" },
        "YYZZ": { "$ref": "#/$defs/tomographyCountVector" },
        "ZZXX": { "$ref": "#/$defs/tomographyCountVector" },
        "ZZYY": { "$ref": "#/$defs/tomographyCountVector" },
        "ZZZZ": { "$ref": "#/$defs/tomographyCountVector" }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backendClass",
        "backendName",
        "providerMode",
        "providerName",
        "mothApi",
        "jobId",
        "shotsPerCircuit",
        "simulatorSeed",
        "transpilerSeed",
        "characterizationCircuitCount",
        "measurementSettings",
        "uniformGameplaySettings",
        "totalShots",
        "logicalMeasurementCircuitQasm",
        "logicalMeasurementCircuitSha256",
        "transpiledAerCircuitQasm",
        "transpiledAerCircuitSha256",
        "tomographyRawCounts",
        "tomographyRawCountsSha256",
        "fullRegisterRawCounts",
        "durableProviderResult",
        "hardwareLayout",
        "backendCalibration",
        "fallbackFrom"
      ],
      "properties": {
        "backendClass": { "const": "AerSimulator" },
        "backendName": { "const": "aer_simulator" },
        "providerMode": { "const": "local-aer" },
        "providerName": { "const": "qiskit-aer" },
        "mothApi": { "const": false },
        "jobId": { "type": "string", "minLength": 1 },
        "shotsPerCircuit": { "type": "integer", "minimum": 128 },
        "simulatorSeed": { "type": "integer", "minimum": 0 },
        "transpilerSeed": { "type": "integer", "minimum": 0 },
        "characterizationCircuitCount": { "const": 9 },
        "measurementSettings": {
          "const": [
            "XXXX",
            "XXYY",
            "XXZZ",
            "YYXX",
            "YYYY",
            "YYZZ",
            "ZZXX",
            "ZZYY",
            "ZZZZ"
          ]
        },
        "uniformGameplaySettings": {
          "const": { "X": "XXXX", "Y": "YYYY", "Z": "ZZZZ" }
        },
        "totalShots": { "type": "integer", "minimum": 1152 },
        "logicalMeasurementCircuitQasm": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "type": "string", "minLength": 1 }
        },
        "logicalMeasurementCircuitSha256": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha" }
        },
        "transpiledAerCircuitQasm": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "type": "string", "minLength": 1 }
        },
        "transpiledAerCircuitSha256": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha" }
        },
        "tomographyRawCounts": { "$ref": "#/$defs/tomographyCounts" },
        "tomographyRawCountsSha256": { "$ref": "#/$defs/sha" },
        "fullRegisterRawCounts": { "$ref": "#/$defs/fullCountContexts" },
        "durableProviderResult": { "const": false },
        "hardwareLayout": { "type": "null" },
        "backendCalibration": { "type": "null" },
        "fallbackFrom": { "type": "null" }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "canonicalEdge",
        "playerOrder",
        "matrixOrder",
        "densityMatrix",
        "pauliExpectations",
        "distributions",
        "productMarginalsControl",
        "fullRegisterMarginals",
        "finiteVsFullRegisterMarginalTotalVariation"
      ],
      "properties": {
        "edgeId": { "enum": ["A-C", "A-D", "B-C", "B-D"] },
        "canonicalEdge": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0, "maximum": 3 }
        },
        "playerOrder": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "enum": ["A", "B", "C", "D"] }
        },
        "matrixOrder": {
          "type": "string",
          "pattern": "^q[0-3]-tensor-q[0-3]$"
        },
        "densityMatrix": {
          "$ref": "urn:fluxball:schema:fixture-bank:v1#/$defs/densityMatrix"
        },
        "pauliExpectations": {
          "$ref": "urn:fluxball:schema:fixture-bank:v1#/$defs/pauliExpectations"
        },
        "distributions": { "$ref": "#/$defs/pairContexts" },
        "productMarginalsControl": { "$ref": "#/$defs/pairContexts" },
        "fullRegisterMarginals": { "$ref": "#/$defs/pairContexts" },
        "finiteVsFullRegisterMarginalTotalVariation": {
          "$ref": "#/$defs/contextNumbers"
        }
      }
    },
    "exactPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distributions", "pauliExpectations"],
      "properties": {
        "distributions": { "$ref": "#/$defs/pairContexts" },
        "pauliExpectations": {
          "$ref": "urn:fluxball:schema:fixture-bank:v1#/$defs/pauliExpectations"
        }
      }
    },
    "pairs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A-C", "A-D", "B-C", "B-D"],
      "properties": {
        "A-C": { "$ref": "#/$defs/pair" },
        "A-D": { "$ref": "#/$defs/pair" },
        "B-C": { "$ref": "#/$defs/pair" },
        "B-D": { "$ref": "#/$defs/pair" }
      }
    },
    "exactPairs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A-C", "A-D", "B-C", "B-D"],
      "properties": {
        "A-C": { "$ref": "#/$defs/exactPair" },
        "A-D": { "$ref": "#/$defs/exactPair" },
        "B-C": { "$ref": "#/$defs/exactPair" },
        "B-D": { "$ref": "#/$defs/exactPair" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureId",
        "circuit",
        "acquisition",
        "derivation",
        "distributions",
        "productMarginalsControl",
        "pairs",
        "exactStateDiagnostic"
      ],
      "properties": {
        "fixtureId": {
          "const": "fluxball-four-player-hybrid-preparation-v1"
        },
        "circuit": { "$ref": "#/$defs/circuit" },
        "acquisition": { "$ref": "#/$defs/acquisition" },
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "outcomeOrder",
            "qiskitCountOrder",
            "pairMatrixOrder",
            "gameplaySource",
            "edgeRole"
          ],
          "properties": {
            "method": { "const": "joint-counts-plus-pairwise-lstsq-psd" },
            "outcomeOrder": { "const": "q0-q1-q2-q3 / A-B-C-D" },
            "qiskitCountOrder": {
              "const": "c3-c2-c1-c0 reversed to q0-q1-q2-q3"
            },
            "pairMatrixOrder": {
              "const": "higher-qubit tensor lower-qubit"
            },
            "gameplaySource": {
              "const": "uniform full-register count frequencies"
            },
            "edgeRole": { "const": "explanation and diagnostics only" }
          }
        },
        "distributions": { "$ref": "#/$defs/fourContexts" },
        "productMarginalsControl": { "$ref": "#/$defs/fourContexts" },
        "pairs": { "$ref": "#/$defs/pairs" },
        "exactStateDiagnostic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acquisitionSource", "distributions", "pairs"],
          "properties": {
            "acquisitionSource": { "const": "exact-statevector" },
            "distributions": { "$ref": "#/$defs/fourContexts" },
            "pairs": { "$ref": "#/$defs/exactPairs" }
          }
        }
      }
    },
    "edgeDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finiteVsExactTotalVariation",
        "finiteVsFullRegisterMarginalTotalVariation",
        "finiteProductMarginalsTotalVariation"
      ],
      "properties": {
        "finiteVsExactTotalVariation": { "$ref": "#/$defs/contextNumbers" },
        "finiteVsFullRegisterMarginalTotalVariation": {
          "$ref": "#/$defs/contextNumbers"
        },
        "finiteProductMarginalsTotalVariation": {
          "$ref": "#/$defs/contextNumbers"
        }
      }
    },
    "edgeDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byEdge",
        "maximumFiniteVsExactTotalVariation",
        "maximumFiniteVsFullRegisterMarginalTotalVariation"
      ],
      "properties": {
        "byEdge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A-C", "A-D", "B-C", "B-D"],
          "properties": {
            "A-C": { "$ref": "#/$defs/edgeDiagnostic" },
            "A-D": { "$ref": "#/$defs/edgeDiagnostic" },
            "B-C": { "$ref": "#/$defs/edgeDiagnostic" },
            "B-D": { "$ref": "#/$defs/edgeDiagnostic" }
          }
        },
        "maximumFiniteVsExactTotalVariation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximumFiniteVsFullRegisterMarginalTotalVariation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "selectionMethod",
        "finiteMinimumOutcomeProbability",
        "finiteMaximumOutcomeProbability",
        "finiteParityPlusProbability",
        "finitePlayerPlusMarginals",
        "finiteProductMarginalsTotalVariation",
        "finiteVsExactTotalVariation",
        "claimBoundary",
        "edgeDiagnostics"
      ],
      "properties": {
        "status": { "const": "accepted-for-local-prototype" },
        "selectionMethod": {
          "const": "authored-rule-legibility-calibration"
        },
        "finiteMinimumOutcomeProbability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "finiteMaximumOutcomeProbability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "finiteParityPlusProbability": { "$ref": "#/$defs/contextNumbers" },
        "finitePlayerPlusMarginals": {
          "$ref": "urn:fluxball:schema:four-qubit-fixture-bank:v1#/$defs/contextPlayerNumbers"
        },
        "finiteProductMarginalsTotalVariation": {
          "$ref": "#/$defs/contextNumbers"
        },
        "finiteVsExactTotalVariation": { "$ref": "#/$defs/contextNumbers" },
        "claimBoundary": { "type": "string", "minLength": 1 },
        "edgeDiagnostics": { "$ref": "#/$defs/edgeDiagnostics" }
      }
    }
  }
}
